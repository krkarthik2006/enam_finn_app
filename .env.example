FINN_DATABASE_PATH=data/finn.sqlite3
# No key is needed for the deterministic demo or evidence retrieval.
FINN_GLM_API_KEY=
FINN_GLM_BASE_URL=https://inference.hyde.tech/v1
# Choose a model enabled on your account. No automatic provider fallback.
FINN_GLM_MODEL=hyde/glm-5.3-flash
# Set a long random token before exposing the API outside localhost.
FINN_API_TOKEN=
FINN_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Explicitly add official company IR hosts before downloading their documents.
FINN_DOCUMENT_HOSTS=["nsearchives.nseindia.com","archives.nseindia.com","www.bseindia.com","www.screener.in","www.ril.com","www.infosys.com"]
# Optional polling; off until live sources are verified. Run only one server worker.
FINN_REFRESH_INTERVAL_SECONDS=0
    
